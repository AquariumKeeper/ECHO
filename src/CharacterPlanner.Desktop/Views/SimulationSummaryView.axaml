<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CharacterPlanner.Desktop.ViewModels"
             x:Class="CharacterPlanner.Desktop.Views.SimulationSummaryView" x:DataType="vm:SimulationSummaryRow">
  <StackPanel Spacing="6" Margin="0,0,0,12">
    <TextBlock Text="{Binding Metric}" Classes="heading" />
    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
      <TextBlock Text="Mean" /><TextBlock Grid.Column="1" Text="{Binding Mean}" />
      <TextBlock Grid.Column="2" Text="Standard deviation" /><TextBlock Grid.Column="3" Text="{Binding StdDev}" />
      <TextBlock Grid.Row="1" Text="Minimum" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Minimum}" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="Maximum" /><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Maximum}" />
      <TextBlock Grid.Row="2" Text="5th percentile" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding P5}" />
      <TextBlock Grid.Row="2" Grid.Column="2" Text="Median (50th)" /><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Median}" />
      <TextBlock Grid.Row="3" Text="95th percentile" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding P95}" />
    </Grid>
  </StackPanel>
</UserControl>
