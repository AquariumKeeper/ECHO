<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CharacterPlanner.Desktop.ViewModels"
             x:Class="CharacterPlanner.Desktop.Views.PartyTabView" x:DataType="vm:EditorViewModel">
  <!-- The Party tab (F44), as the Go app's party.go: the hint and add buttons over the member cards. -->
  <DockPanel Name="PartyPanel">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="{x:Static vm:PartyViewModel.Hint}" Classes="label" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="AddFromCodeButton" Content="Add from Share Code" IsEnabled="{Binding Party.CanAdd}" Click="OnAddFromCode" />
        <Button Name="AddFromLibraryButton" Content="Add from Library" IsEnabled="{Binding Party.CanAdd}" Click="OnAddFromLibrary" />
        <Button Name="AddByHandButton" Content="Add by Hand" IsEnabled="{Binding Party.CanAdd}" Click="OnAddByHand" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="8" Margin="0,0,8,0">
        <TextBlock Name="PartyEmptyText" Text="{x:Static vm:PartyViewModel.Empty}" IsVisible="{Binding Party.IsEmpty}" />
        <ItemsControl Name="PartyMembers" ItemsSource="{Binding Party.Members}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PartyMemberViewModel">
              <Border Classes="slot">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Name}" Classes="heading" />
                  <TextBlock Text="{Binding Source}" Classes="label" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Re-read" Command="{Binding RereadCommand}" IsVisible="{Binding CanReread}" />
                    <Button Content="Remove" Command="{Binding RemoveCommand}" />
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,200,*" ColumnSpacing="8" IsVisible="{Binding IsHandEntered}">
                    <TextBlock Text="Armor" VerticalAlignment="Center" />
                    <Panel Grid.Column="1" DataContext="{Binding Armor}">
                      <TextBox x:DataType="vm:PartyArmorViewModel" Text="{Binding ValueText}" AutomationProperties.Name="Armor" />
                    </Panel>
                    <TextBlock Grid.Column="2" Text="{x:Static vm:PartyMemberViewModel.ArmorHint}" Classes="label" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <ComboBox ItemsSource="{Binding BuffChoices}" SelectedItem="{Binding SelectedBuff}" PlaceholderText="{x:Static vm:PartyMemberViewModel.BuffPlaceholder}"
                            IsVisible="{Binding IsHandEntered}" MinWidth="280" AutomationProperties.Name="Add a buff" />
                  <TextBlock Text="{x:Static vm:PartyMemberViewModel.NoBuffs}" IsVisible="{Binding GrantsNothing}" />
                  <ItemsControl ItemsSource="{Binding Effects}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PartyEffectViewModel">
                        <StackPanel Spacing="2" Margin="0,2">
                          <CheckBox Content="{Binding Label}" IsChecked="{Binding IsActive}" IsVisible="{Binding IsKnown}" />
                          <TextBlock Text="{Binding Description}" Classes="label" TextWrapping="Wrap" IsVisible="{Binding IsKnown}" />
                          <TextBlock Text="{x:Static vm:PartyEffectViewModel.Outranked}" Classes="warning" TextWrapping="Wrap" IsVisible="{Binding IsOutranked}" />
                          <TextBlock Text="{Binding Warning}" Classes="warning" TextWrapping="Wrap" IsVisible="{Binding IsStale}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
