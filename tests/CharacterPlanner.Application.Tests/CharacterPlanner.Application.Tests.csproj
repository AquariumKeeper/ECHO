<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/CharacterPlanner.Application/CharacterPlanner.Application.csproj" />
    <!-- Legacy reads the frozen v1 build documents the fixtures start from. -->
    <ProjectReference Include="../../src/CharacterPlanner.Legacy/CharacterPlanner.Legacy.csproj" />
    <Using Include="Xunit" />
    <None Include="../../data/packs/division-2/*" Link="packs/division-2/%(Filename)%(Extension)" CopyToOutputDirectory="IfDifferent" />
    <None Include="../../baseline/fixtures/builds/**/operations.json" Link="builds/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../baseline/fixtures/builds/**/apply.json" Link="builds/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../baseline/fixtures/builds/**/document.json" Link="builds/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../baseline/fixtures/cli/**/*.json" Link="cli/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../baseline/fixtures/errors/*.json" Link="errors/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../baseline/fixtures/session/*.json" Link="session/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/artwork/minimal-slots/**" Link="artwork-example/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../baseline/cli-describe.json" Link="cli-describe.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
