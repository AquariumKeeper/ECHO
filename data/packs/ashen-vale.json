{
  "id": "ashen_vale",
  "name": "Ashen Vale",
  "schemaVersion": 1,
  "version": "0.1.0",
  "description": "An original ARPG-flavoured system used as the reference pack. Exercises every engine feature: curve-based soft caps, multi-level derived stats, two-handed weapons, conditional modifiers, and set bonuses.",

  "scenarios": [
    { "id": "buffed", "name": "Buffed", "tag": "buffed" },
    { "id": "vs_boss", "name": "Against a Boss", "tag": "vs_boss" }
  ],

  "theme": { "primary": "#b5652d", "background": "#1b1712" },

  "layout": {
    "slotGroups": [
      { "name": "Weapons", "slots": ["mainhand", "offhand"], "compareStats": ["dps", "attack_power", "spell_power"] },
      { "name": "Armor", "slots": ["head", "chest", "hands", "legs"], "columns": 2, "compareStats": ["ehp", "armor", "equip_load"] },
      { "name": "Accessories", "slots": ["amulet", "ring"], "compareStats": ["hp", "attack_power", "crit_chance"] }
    ],
    "summary": [
      { "name": "Offense", "stats": ["dps", "attack_power", "spell_power", "crit_chance", "crit_damage"] },
      { "name": "Defense", "stats": ["hp", "ehp", "armor", "physical_resist", "magic_resist"] },
      { "name": "Load", "stats": ["stamina", "equip_load"] }
    ]
  },

  "progression": {
    "startingLevel": 1,
    "maxLevel": 60,
    "pointsPerLevel": 3,
    "startingPoints": 0
  },

  "stats": [
    { "id": "vigor", "name": "Vigor", "kind": "primary", "base": 10, "min": 8, "max": 99, "description": "Raises health." },
    { "id": "endurance", "name": "Endurance", "kind": "primary", "base": 10, "min": 8, "max": 99, "description": "Raises stamina and equip load." },
    { "id": "strength", "name": "Strength", "kind": "primary", "base": 10, "min": 8, "max": 99, "description": "Scales heavy weapons." },
    { "id": "dexterity", "name": "Dexterity", "kind": "primary", "base": 10, "min": 8, "max": 99, "description": "Scales fast weapons and critical chance." },
    { "id": "intellect", "name": "Intellect", "kind": "primary", "base": 10, "min": 8, "max": 99, "description": "Scales sorceries." },
    { "id": "faith", "name": "Faith", "kind": "primary", "base": 10, "min": 8, "max": 99, "description": "Scales incantations." },

    {
      "id": "hp",
      "name": "Health",
      "shortName": "HP",
      "kind": "derived",
      "formula": "curve('hp_from_vigor', vigor) + endurance * 3",
      "format": "integer",
      "min": 1
    },
    {
      "id": "stamina",
      "name": "Stamina",
      "kind": "derived",
      "formula": "curve('stamina_from_endurance', endurance)",
      "format": "integer",
      "min": 0
    },
    {
      "id": "equip_load",
      "name": "Equip Load",
      "shortName": "Load",
      "kind": "derived",
      "formula": "40 + strength * 1.5 + endurance * 2",
      "format": "decimal",
      "min": 0
    },
    {
      "id": "attack_power",
      "name": "Attack Power",
      "shortName": "ATK",
      "kind": "derived",
      "formula": "curve('attack_from_strength', strength) + curve('attack_from_dexterity', dexterity)",
      "format": "integer",
      "min": 0
    },
    {
      "id": "spell_power",
      "name": "Spell Power",
      "shortName": "SPL",
      "kind": "derived",
      "formula": "curve('spell_from_intellect', intellect) + curve('spell_from_faith', faith)",
      "format": "integer",
      "min": 0
    },
    {
      "id": "armor",
      "name": "Armor",
      "shortName": "Armor",
      "kind": "derived",
      "formula": "0",
      "format": "integer",
      "min": 0
    },
    {
      "id": "crit_chance",
      "name": "Critical Chance",
      "shortName": "Crit",
      "kind": "derived",
      "formula": "0.05 + dexterity * 0.002",
      "format": "percent",
      "min": 0,
      "max": 1
    },
    {
      "id": "crit_damage",
      "name": "Critical Damage",
      "kind": "derived",
      "formula": "1.5",
      "format": "decimal",
      "min": 1
    },
    {
      "id": "physical_resist",
      "name": "Physical Resistance",
      "kind": "derived",
      "formula": "clamp(armor / (armor + 600), 0, 0.75)",
      "format": "percent",
      "min": 0,
      "max": 0.75
    },
    {
      "id": "magic_resist",
      "name": "Magic Resistance",
      "kind": "derived",
      "formula": "0",
      "format": "percent",
      "min": 0,
      "max": 0.75
    },
    {
      "id": "ehp",
      "name": "Effective Health",
      "shortName": "EHP",
      "kind": "derived",
      "formula": "hp / (1 - physical_resist)",
      "format": "integer",
      "min": 1,
      "description": "Health scaled by physical mitigation."
    },
    {
      "id": "dps",
      "name": "Damage per Second",
      "shortName": "DPS",
      "kind": "derived",
      "formula": "attack_power * (1 + crit_chance * (crit_damage - 1))",
      "format": "decimal",
      "min": 0
    }
  ],

  "curves": {
    "hp_from_vigor": [[8, 300], [20, 600], [30, 850], [40, 1050], [60, 1200], [99, 1300]],
    "stamina_from_endurance": [[8, 80], [20, 110], [30, 135], [40, 150], [60, 160], [99, 170]],
    "attack_from_strength": [[8, 20], [20, 60], [40, 110], [60, 135], [99, 150]],
    "attack_from_dexterity": [[8, 18], [20, 55], [40, 100], [60, 125], [99, 140]],
    "spell_from_intellect": [[8, 15], [20, 55], [40, 105], [60, 130], [99, 145]],
    "spell_from_faith": [[8, 15], [20, 55], [40, 105], [60, 130], [99, 145]]
  },

  "slots": [
