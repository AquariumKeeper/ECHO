<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.2.0-beta.6</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <!-- Debug policy (owner, 2026-11-09): normal builds keep the SDK's SourceLink. A release package maps source paths to /_/
         and turns source links off, so stack traces keep their line numbers and a release names no folder, account or commit. -->
    <DebugType Condition="'$(ReleasePackage)' == 'true'">embedded</DebugType>
    <PathMap Condition="'$(ReleasePackage)' == 'true'">$(MSBuildThisFileDirectory)=/_/</PathMap>
    <EnableSourceLink Condition="'$(ReleasePackage)' == 'true'">false</EnableSourceLink>
    <EnableSourceControlManagerQueries Condition="'$(ReleasePackage)' == 'true'">false</EnableSourceControlManagerQueries>
  </PropertyGroup>
</Project>
